#!/bin/zsh
# Claude Code via OpenRouter (Anthropic-compatible endpoint).
# Env vars apply only to this process; plain `claude` keeps your Anthropic login.
#
#   claude-or <openrouter-model-id> [claude args...]   any model, no alias needed
#   claude-or <alias> [claude args...]                 alias from aliases.json
#   <alias> [claude args...]                           via symlink named like the alias
#   claude-or --list                                   show aliases
#   claude-or --add <alias> <model-id> [context]       add alias to aliases.json, then --link
#   claude-or --update <alias> <property> <value>      set model, context or small of an alias
#   claude-or --remove <alias>...                      remove alias(es), then --link
#   claude-or --link                                   sync symlinks with aliases.json
#   claude-or --unlink                                 remove all alias symlinks (aliases.json kept)
#   claude-or --key-add <name> [key]                   save a named OpenRouter key (prompted if no key)
#   claude-or --key-remove <index|name>...             delete saved key(s)
#   claude-or --key-list                               show saved keys (masked), * = active
#   claude-or --key-switch <index|name>                make a saved key the active one
#   claude-or --stats [index|name]                     spend of a saved key on OpenRouter (default: active)
#   claude-or --key-run <index|name> <alias|model-id> [claude args...]
#                                                      run with a saved key, active key unchanged
#   claude-or --self-update                            update to the latest release tag
#   claude-or --self-factory-reset                     delete keys and aliases, restore default aliases
#   claude-or --self-uninstall                         also delete the config dir and this script
#   claude-or [--help]                                 help with examples
#
# Config dir: ${XDG_CONFIG_HOME:-~/.config}/claude-or/
#   aliases.json   {"defaults": {"small": "<model>"},
#                   "aliases": {"<name>": {"model": "<id>", "context": <tokens>, "small": "<id>"}}}
#                  "context" and "small" are optional.
#   keys.json      {"active": "<name>", "keys": [{"name": "<name>", "key": "<key>"}]} (chmod 600)
#
# Key lookup: the key given with --key-run or $OR_KEY, else $OPENROUTER_API_KEY, else the active key in keys.json, else macOS Keychain service
# "openrouter-api-key".
#   security add-generic-password -a "$USER" -s openrouter-api-key -w

cfgdir="${XDG_CONFIG_HOME:-$HOME/.config}/claude-or"
aliasfile="$cfgdir/aliases.json"
self="${0:A}"   # real script path (symlinks resolved)
repo=dariusz-przada/claude-or
name="${0:t}"

die() { print -u2 "${name}: $*"; exit 1; }

# Aliases need jq; running a model id directly (claude-or vendor/model) doesn't.
need_jq() {
  whence -p jq >/dev/null && return
  local hint="brew install jq"
  [[ "$OSTYPE" == linux* ]] && hint="sudo apt install jq  (or: dnf / pacman / apk install jq)"
  die "aliases need jq, which isn't installed. Install it: $hint
Without jq you can still run a model directly: claude-or <vendor/model-id>"
}

need_aliases() {
  need_jq
  [[ -r "$aliasfile" ]] || die "no alias file: $aliasfile"
  jq -e '.aliases | type == "object"' "$aliasfile" >/dev/null 2>&1 \
    || die "$aliasfile: invalid JSON or missing \"aliases\" object"
}

# Sets model / ctx / small for alias $1; returns 1 if the alias doesn't exist.
load_alias() {
  local vars
  vars="$(jq -r --arg a "$1" '
    .defaults.small as $ds
    | .aliases[$a] // empty
    | "model=\(.model // "" | @sh) ctx=\(.context // "" | tostring | @sh) small=\(.small // $ds // "" | @sh)"
  ' "$aliasfile")" || return 1
  [[ -n "$vars" ]] || return 1
  eval "$vars"
  [[ -n "$model" ]] || die "alias '$1' has no \"model\" in $aliasfile"
}

list_aliases() {
  need_aliases
  jq -r '.defaults.small as $ds | .aliases | to_entries[]
    | [.key, .value.model, (.value.context // "-" | tostring), (.value.small // $ds // "-")] | @tsv' "$aliasfile" \
    | column -t -s $'\t'
}

# Prints why alias name $1 can't get a symlink; prints nothing if it can.
name_problem() {
  local a="$1" target="${self:h}/$1" other
  if [[ ! "$a" =~ '^[A-Za-z0-9_.-]+$' || "$a" == claude-or ]]; then
    print "invalid alias name '$a' (allowed: letters, digits, . _ -)"; return
  fi
  if [[ -e "$target" && ! ( -L "$target" && "$(readlink "$target")" == claude-or ) ]]; then
    print "$target exists and is not a claude-or symlink"; return
  fi
  other="$(whence -pa "$a" | grep -vx "$target" | head -1)"
  [[ -n "$other" ]] && print "'$a' would shadow $other, pick another name"
}

link_aliases() {
  need_aliases
  local bindir="${self:h}" a target problem
  local -a want
  want=("${(@f)$(jq -r '.aliases | keys[]' "$aliasfile")}")
  for a in $want; do
    problem="$(name_problem "$a")"
    if [[ -n "$problem" ]]; then
      print -u2 "skip $a: $problem"; continue
    fi
    target="$bindir/$a"
    ln -sfn claude-or "$target"
    print "linked  $a"
  done
  # Drop symlinks to this script whose alias was removed from the JSON.
  for target in "$bindir"/*(N@); do
    a="${target:t}"
    [[ "$(readlink "$target")" == claude-or && ${want[(Ie)$a]} -eq 0 ]] || continue
    rm "$target" && print "removed $a"
  done
}

unlink_aliases() {
  local target n=0
  for target in "${self:h}"/*(N@); do
    [[ "$(readlink "$target")" == claude-or ]] || continue
    rm "$target" && print "removed ${target:t}" && (( n++ ))
  done
  (( n )) || print "no alias symlinks to remove"
  print "aliases.json is untouched: use claude-or <alias|model-id>, or claude-or --link to restore"
}

# Applies jq filter/args "$@" to aliases.json, replacing the file only if jq succeeds.
write_aliases() {
  local tmp
  tmp="$(mktemp "$cfgdir/.aliases.XXXXXX")" || die "can't write to $cfgdir"
  if jq "$@" < "$aliasfile" > "$tmp"; then
    mv "$tmp" "$aliasfile"
  else
    rm -f "$tmp"; die "failed to update $aliasfile"
  fi
}

# Verifies model $1 on OpenRouter and sets model_ctx to its context window. Dies if the model
# doesn't exist; only warns if OpenRouter can't be reached (model_ctx stays empty).
check_model() {
  local m="$1" catalog info
  model_ctx=""
  catalog="$(curl -fsS -m 20 https://openrouter.ai/api/v1/models 2>/dev/null)"
  if [[ -z "$catalog" ]]; then
    print -u2 "warning: couldn't reach OpenRouter, model '$m' not verified"; return
  fi
  info="$(jq -r --arg m "$m" '.data[] | select(.id == $m)
    | "\(.context_length // "") \((.supported_parameters // []) | index("tools") != null)"' <<< "$catalog")"
  [[ -n "$info" ]] || die "model '$m' not found on OpenRouter (see https://openrouter.ai/models)"
  [[ "${info#* }" == true ]] \
    || print -u2 "warning: '$m' doesn't list tool support; Claude Code needs tool calls"
  model_ctx="${info%% *}"
}

need_alias() {
  jq -e --arg a "$1" '.aliases | has($a)' "$aliasfile" >/dev/null \
    || die "alias '$1' not found in $aliasfile (see claude-or --list)"
}

add_alias() {
  (( $# == 2 || $# == 3 )) || die "usage: claude-or --add <alias> <openrouter-model-id> [context]"
  local a="$1" m="$2" c="$3" problem model_ctx
  need_jq
  if [[ ! -e "$aliasfile" ]]; then
    mkdir -p "$cfgdir" && print '{ "aliases": {} }' > "$aliasfile"
  fi
  need_aliases
  jq -e --arg a "$a" '.aliases | has($a)' "$aliasfile" >/dev/null \
    && die "alias '$a' already exists in $aliasfile"
  problem="$(name_problem "$a")"
  [[ -z "$problem" ]] || die "$problem"
  [[ -z "$c" || "$c" == <-> ]] || die "context must be a whole number of tokens, got '$c'"

  # Verify the model on OpenRouter and take its context window if none was given.
  check_model "$m"
  [[ -z "$c" ]] && c="$model_ctx"

  write_aliases --arg a "$a" --arg m "$m" --arg c "$c" \
    '.aliases[$a] = {model: $m} + (if $c == "" then {} else {context: ($c | tonumber)} end)'
  print "added   $a -> $m${c:+ (context $c)}"
  link_aliases
}

update_alias() {
  (( $# == 3 )) || die "usage: claude-or --update <alias> <model|context|small> <value>"
  local a="$1" p="$2" v="$3" old model_ctx
  need_aliases
  need_alias "$a"
  case "$p" in
    model|small) check_model "$v" ;;
    context)
      [[ "$v" == <-> ]] && (( v > 0 )) \
        || die "context must be a whole number of tokens, got '$v'" ;;
    *) die "unknown property '$p' (allowed: model, context, small)" ;;
  esac
  old="$(jq -r --arg a "$a" --arg p "$p" '.aliases[$a][$p] // "-" | tostring' "$aliasfile")"

  write_aliases --arg a "$a" --arg p "$p" --arg v "$v" \
    '.aliases[$a][$p] = (if $p == "context" then ($v | tonumber) else $v end)'
  print "updated $a: $p $old -> $v"

  # A new model usually has a different window than the one stored for the old model.
  if [[ "$p" == model && -n "$model_ctx" ]]; then
    old="$(jq -r --arg a "$a" '.aliases[$a].context // "" | tostring' "$aliasfile")"
    [[ "$old" == "$model_ctx" ]] || print -u2 "note: '$v' has a $model_ctx-token context window," \
      "alias has ${old:-none}; to match: claude-or --update $a context $model_ctx"
  fi
}

remove_alias() {
  (( $# >= 1 )) || die "usage: claude-or --remove <alias>..."
  need_aliases
  local a
  for a in "$@"; do need_alias "$a"; done
  write_aliases --args 'reduce $ARGS.positional[] as $a (.; del(.aliases[$a]))' "$@"
  link_aliases
}

# Replaces this script with the one from the newest version tag on GitHub; aliases.json is kept.
self_update() {
  setopt localoptions extendedglob
  local tag tmp
  local -a tags
  tags=(${(f)"$(curl -fsS -m 20 "https://api.github.com/repos/$repo/tags?per_page=100" 2>/dev/null \
    | sed -n 's/.*"name": *"\([^"]*\)".*/\1/p')"})
  tags=(${(M)tags:#(v|)<->(.<->)#})
  (( $#tags )) || die "couldn't find a release tag on github.com/$repo"
  tags=(${(On)tags})   # newest first, numeric: v1.10.0 before v1.9.0
  tag="$tags[1]"

  tmp="$(mktemp "${self:h}/.claude-or.XXXXXX")" || die "can't write to ${self:h}"
  if ! curl -fsSL -m 30 "https://raw.githubusercontent.com/$repo/$tag/claude-or" -o "$tmp"; then
    rm -f "$tmp"; die "download of $tag failed"
  fi
  # Guard against an error page or a truncated download replacing a working script.
  if [[ "$(head -1 "$tmp")" != '#!/bin/zsh' ]] || ! zsh -n "$tmp"; then
    rm -f "$tmp"; die "downloaded $tag doesn't look like claude-or, not updated"
  fi
  if cmp -s "$tmp" "$self"; then
    rm -f "$tmp"; print "already up to date ($tag)"; return
  fi
  chmod 755 "$tmp" && mv "$tmp" "$self" || { rm -f "$tmp"; die "can't replace $self"; }
  print "updated $self to $tag"
  # Re-link with the new version, in case it changed how aliases are linked.
  whence -p jq >/dev/null && [[ -r "$aliasfile" ]] && "$self" --link
  return 0
}

keysfile="$cfgdir/keys.json"

# jq helper: shortens a key to its first 5 and last 4 characters.
jq_mask='def mask: if length > 12 then .[0:5] + "..." + .[-4:] else "***" end;'

# Applies jq filter/args "$@" to keys.json (mode 600), replacing the file only if jq succeeds.
write_keys() {
  local tmp
  tmp="$(mktemp "$cfgdir/.keys.XXXXXX")" || die "can't write to $cfgdir"
  if jq "$@" < "$keysfile" > "$tmp" && chmod 600 "$tmp"; then
    mv "$tmp" "$keysfile"
  else
    rm -f "$tmp"; die "failed to update $keysfile"
  fi
}

# Creates an empty keys.json on first use.
need_keys() {
  need_jq
  if [[ ! -e "$keysfile" ]]; then
    mkdir -p "$cfgdir" && ( umask 077; print '{ "active": null, "keys": [] }' > "$keysfile" ) \
      || die "can't write to $cfgdir"
  fi
  jq -e '.keys | type == "array"' "$keysfile" >/dev/null 2>&1 \
    || die "$keysfile: invalid JSON or missing \"keys\" array"
}

# Sets kname to the name of the key given by index (1-based) or name $1; dies if there's none.
resolve_key() {
  kname="$(jq -r --arg r "$1" '
    if ($r | test("^[0-9]+$")) then ($r | tonumber) as $i | if $i >= 1 then .keys[$i - 1].name // empty else empty end
    else .keys[] | select(.name == $r) | .name end' "$keysfile")"
  [[ -n "$kname" ]] || die "no key '$1' (see claude-or --key-list)"
}

masked_key() {
  jq -r --arg n "$1" "$jq_mask"' .keys[] | select(.name == $n) | .key | mask' "$keysfile"
}

env_key_note() {
  [[ -n "$OPENROUTER_API_KEY" ]] \
    && print -u2 "note: \$OPENROUTER_API_KEY is set and takes precedence over $keysfile"
  return 0
}

# Reads a key into $key from a hidden prompt, or from stdin when piped.
read_secret() {
  if [[ -t 0 ]]; then
    read -rs "key?OpenRouter API key: "; print -u2
  else
    read -r key
  fi
}

# Checks key $1 on OpenRouter: dies if rejected, only warns if OpenRouter can't be reached.
verify_key() {
  local code
  code="$(curl -sS -m 20 -o /dev/null -w '%{http_code}' \
    -H "Authorization: Bearer $1" https://openrouter.ai/api/v1/key 2>/dev/null)"
  case "$code" in
    200) ;;
    401|403) die "OpenRouter rejected this key, not saved" ;;
    *) print -u2 "warning: couldn't verify the key on OpenRouter (HTTP ${code:-000}), saving anyway" ;;
  esac
}

# Without [key] the key is prompted (hidden) or piped, which keeps it out of shell history.
key_add() {
  (( $# == 1 || $# == 2 )) || die "usage: claude-or --key-add <name> [key]   (without key: prompts, or reads a pipe)"
  local n="$1" key="$2" dup
  need_keys
  [[ "$n" =~ '^[A-Za-z0-9_.-]+$' && "$n" != <-> ]] \
    || die "invalid key name '$n' (letters, digits, . _ -; not only digits, those are indexes)"
  jq -e --arg n "$n" 'any(.keys[]; .name == $n)' "$keysfile" >/dev/null \
    && die "key '$n' already exists (see claude-or --key-list)"

  [[ -n "$key" ]] || read_secret
  key="${key//[[:space:]]/}"
  [[ -n "$key" ]] || die "no key given, nothing saved"
  # The key goes to jq through the environment, not as an argument visible in ps.
  local -x K="$key"
  dup="$(jq -r '.keys[] | select(.key == env.K) | .name' "$keysfile")"
  [[ -z "$dup" ]] || die "this key is already saved as '$dup'"
  verify_key "$key"

  write_keys --arg n "$n" '.keys += [{name: $n, key: env.K}] | .active //= $n'
  if [[ "$(jq -r '.active' "$keysfile")" == "$n" ]]; then
    print "added $n ($(masked_key "$n")), active"
  else
    print "added $n ($(masked_key "$n")); to use it: claude-or --key-switch $n"
  fi
  env_key_note
}

key_remove() {
  (( $# >= 1 )) || die "usage: claude-or --key-remove <index|name>..."
  need_keys
  local r kname active
  local -a names
  # Resolve all first, so a typo removes nothing; indexes refer to the list before removal.
  for r in "$@"; do resolve_key "$r"; names+=("$kname"); done
  names=(${(u)names})
  active="$(jq -r '.active // empty' "$keysfile")"
  write_keys --args '.keys |= map(select(.name | IN($ARGS.positional[]) | not))
    | if (.active | IN($ARGS.positional[])) then .active = null else . end' "${names[@]}"
  for r in $names; do print "removed $r"; done
  if [[ -n "$active" && ${names[(Ie)$active]} -gt 0 ]]; then
    print -u2 "note: '$active' was the active key; pick another: claude-or --key-switch <index|name>"
  fi
  return 0
}

key_list() {
  (( $# == 0 )) || die "usage: claude-or --key-list"
  need_keys
  if ! jq -e '.keys | length > 0' "$keysfile" >/dev/null; then
    print "no keys yet: claude-or --key-add <name>"; return 0
  fi
  jq -r "$jq_mask"' .active as $a | .keys | to_entries[]
    | [(if .value.name == $a then "*" else "" end), (.key + 1 | tostring), .value.name, (.value.key | mask)]
    | @tsv' "$keysfile" | awk -F'\t' '{ printf "%1s %2s  %s\t%s\n", $1, $2, $3, $4 }' | column -t -s $'\t'
  jq -e '.active as $a | any(.keys[]; .name == $a)' "$keysfile" >/dev/null \
    || print -u2 "note: no active key; pick one: claude-or --key-switch <index|name>"
  env_key_note
}

key_switch() {
  (( $# == 1 )) || die "usage: claude-or --key-switch <index|name>"
  local kname
  need_keys
  resolve_key "$1"
  write_keys --arg n "$kname" '.active = $n'
  print "active key: $kname ($(masked_key "$kname"))"
  env_key_note
}

# Formats a dollar amount; sub-cent amounts get 4 decimals so they don't show as $0.00.
money() {
  if (( $1 > 0 && $1 < 0.01 )); then printf '$%.4f' "$1"; else printf '$%.2f' "$1"; fi
}

# Shortens an ISO timestamp (2026-10-19T00:00:00.000Z) to "2026-10-19 00:00 UTC".
utc_time() {
  local t="${1/T/ }"
  print -rn -- "${t[1,16]} UTC"
}

# Shows the spend OpenRouter has recorded for a saved key (default: the active one).
key_stats() {
  (( $# <= 1 )) || die "usage: claude-or --stats [index|name]"
  local kname resp code active
  need_keys
  active="$(jq -r '.active as $a | .keys[] | select(.name == $a) | .name' "$keysfile")"
  if (( $# )); then
    resolve_key "$1"
  else
    [[ -n "$active" ]] || die "no active key; claude-or --stats <index|name>"
    kname="$active"
  fi

  # The header goes to curl on stdin, so the key isn't visible in ps.
  resp="$(jq -r --arg n "$kname" '.keys[] | select(.name == $n) | "Authorization: Bearer \(.key)"' "$keysfile" \
    | curl -sS -m 20 -w '\n%{http_code}' -H @- https://openrouter.ai/api/v1/key 2>/dev/null)"
  code="${resp##*$'\n'}"
  resp="${resp%$'\n'*}"
  case "$code" in
    200) ;;
    401|403) die "OpenRouter rejected key '$kname'" ;;
    *) die "couldn't get stats from OpenRouter (HTTP ${code:-000})" ;;
  esac

  local -a rows
  # A budget that is just the key's own limit only adds its reset time to the limit row.
  rows=("${(@f)$(jq -r '.data
    | (.effective_budget // null) as $b
    | ($b != null and $b.limit_usd == .limit and ($b.reset_interval // null) == .limit_reset) as $same
    | ["today", .usage_daily], ["this week", .usage_weekly], ["this month", .usage_monthly], ["total", .usage],
      ["limit", .limit, .limit_remaining, (.limit_reset // ""), (if $same then $b.resets_at // "" else "" end)],
      ($b // empty | select($same | not)
        | ["budget", .limit_usd, .spend_usd, (.reset_interval // ""), (.resets_at // "")]),
      (select((.byok_usage // 0) > 0) | ["byok", .byok_usage_daily, .byok_usage_weekly, .byok_usage_monthly, .byok_usage]),
      (select(.is_free_tier) | .free_model_daily_requests // empty | ["free reqs", .used, .limit])
    | map(. // "" | tostring) | @tsv' <<< "$resp")}") \
    || die "unexpected response from OpenRouter"

  local row label line
  local -a f
  printf '%-11s %s\n' key "$kname ($(masked_key "$kname"))${${(M)kname:#$active}:+, active}"
  for row in $rows; do
    f=("${(@ps:\t:)row}")
    label="$f[1]"
    case "$label" in
      limit)
        if [[ -z "$f[2]" ]]; then line="none"
        else line="$(money "$f[2]")${f[4]:+ $f[4]}, $(money "$f[3]") left${f[5]:+, resets $(utc_time "$f[5]")}"; fi ;;
      budget)
        line="$(money "$f[2]")${f[4]:+ $f[4]}, $(money "$f[3]") spent${f[5]:+, resets $(utc_time "$f[5]")}" ;;
      byok)
        line="today $(money "$f[2]"), week $(money "$f[3]"), month $(money "$f[4]"), total $(money "$f[5]")" ;;
      "free reqs")
        line="$f[2]/$f[3] today" ;;
      *) line="$(money "$f[2]")" ;;
    esac
    printf '%-11s %s\n' "$label" "$line"
  done
  env_key_note
}

# Prints the symlinks next to the script that point to it, one per line.
alias_links() {
  local target
  for target in "${self:h}"/*(N@); do
    [[ "$(readlink "$target")" == claude-or ]] && print -r -- "$target"
  done
  return 0
}

# Lists paths $@, asks [y/N] on the terminal and deletes them on yes; returns 1 if declined.
confirm_delete() {
  local f
  print "this deletes:"
  for f in "$@"; do print "  $f"; done
  { : < /dev/tty } 2>/dev/null || die "run in a terminal to confirm, nothing deleted"
  if ! read -q "?Continue? [y/N] " < /dev/tty; then
    print; print "nothing deleted"; return 1
  fi
  print
  for f in "$@"; do
    rm -rf -- "$f" && print "removed $f" || print -u2 "can't remove $f"
  done
}

# Key sources outside claude-or's files, which a reset or uninstall leaves alone.
kept_key_notes() {
  security find-generic-password -a "$USER" -s openrouter-api-key >/dev/null 2>&1 \
    && print -u2 "note: Keychain 'openrouter-api-key' is kept; to remove it:" \
      "security delete-generic-password -a \"\$USER\" -s openrouter-api-key"
  [[ -n "$OPENROUTER_API_KEY" ]] && print -u2 "note: \$OPENROUTER_API_KEY is still set in your environment"
  return 0
}

# Deletes keys.json, aliases.json and the alias symlinks after a confirmation, then puts back the
# default aliases.json from GitHub and links it; the script stays.
self_factory_reset() {
  (( $# == 0 )) || die "usage: claude-or --self-factory-reset"
  local f defaults
  local -a files
  need_jq
  # Fetch the defaults first, so a failed download leaves everything as it was.
  defaults="$(curl -fsSL -m 20 "https://raw.githubusercontent.com/$repo/main/aliases.json" 2>/dev/null)"
  jq -e '.aliases | type == "object"' <<< "$defaults" >/dev/null 2>&1 \
    || die "couldn't download the default aliases.json from github.com/$repo, nothing deleted"

  for f in "$keysfile" "$aliasfile"; do [[ -e "$f" ]] && files+=("$f"); done
  files+=(${(f)"$(alias_links)"})
  if (( $#files )); then
    print "factory reset: deletes the files below, then restores the default aliases.json and its symlinks"
    confirm_delete $files || return 0
  fi
  mkdir -p "$cfgdir" && print -r -- "$defaults" > "$aliasfile" || die "can't write $aliasfile"
  print "restored default $aliasfile"
  link_aliases
  kept_key_notes
}

# Deletes the alias symlinks, the whole config dir and this script after a confirmation.
self_uninstall() {
  (( $# == 0 )) || die "usage: claude-or --self-uninstall"
  local -a files
  files=(${(f)"$(alias_links)"})
  # cfgdir always ends in /claude-or, so this never removes a shared config dir.
  [[ -e "$cfgdir" && "${cfgdir:t}" == claude-or ]] && files+=("$cfgdir")
  files+=("$self")
  confirm_delete $files || return 0
  kept_key_notes
  print "claude-or is uninstalled"
}

show_help() {
  cat <<EOF
claude-or: run Claude Code against OpenRouter models (DeepSeek, Kimi, GLM, Qwen, ...)

Usage:
  <alias> [claude args...]                      run an alias, e.g. ccds
  claude-or <alias> [claude args...]            same, without needing the symlink
  claude-or <model-id> [claude args...]         any OpenRouter model, no alias needed

Aliases:
  claude-or --list                              show aliases (name, model, context, background model)
  claude-or --add <alias> <model-id> [context]  validate and add an alias, then --link
                                                (context defaults to the model's window on OpenRouter)
  claude-or --update <alias> <property> <value>
                                                validate and set an alias property:
                                                model, small (OpenRouter model id), context (tokens)
  claude-or --remove <alias>...                 remove alias(es) and their symlinks
  claude-or --link                              sync symlinks with aliases.json
  claude-or --unlink                            remove all alias symlinks; aliases.json is kept,
                                                so claude-or <alias> still works

OpenRouter keys:
  claude-or --key-add <name> [key]              verify and save a named OpenRouter key; the first one
                                                becomes active. Without [key]: hidden prompt, or piped
                                                (pbpaste | claude-or --key-add work), out of shell history
  claude-or --key-remove <index|name>...        delete saved key(s)
  claude-or --key-list                          show saved keys: * active, index, name, masked key
  claude-or --key-switch <index|name>           make a saved key the active one
  claude-or --stats [index|name]                spend OpenRouter recorded for a saved key: today, week,
                                                month, total, limit (default: the active key)
  claude-or --key-run <index|name> <alias|model-id> [claude args...]
                                                run an alias or model with a saved key, just this once;
                                                the active key stays as it is

claude-or itself:
  claude-or --self-update                       update to the latest release tag (aliases.json kept)
  claude-or --self-factory-reset                delete keys.json, aliases.json and alias symlinks,
                                                then restore the default aliases (asks first)
  claude-or --self-uninstall                    delete alias symlinks, the config dir and claude-or
                                                itself (asks first)
  claude-or --help                              this help

Examples:
  ccds                                          interactive session on DeepSeek V4 Pro
  ccds -p "explain this repo" < /dev/null       one-shot, headless (e.g. from another Claude session)
  claude-or ccdsf --resume                      resume a session on DeepSeek V4 Flash
  claude-or --key-run work ccds                 DeepSeek V4 Pro billed to the saved key 'work'
  OR_KEY=work claude-or ccds                    same, with OR_KEY
  OR_KEY=work ccds                              same, through the alias symlink
  OR_KEY=2 ccdsf --resume                       resume on DeepSeek V4 Flash with saved key #2
  OR_KEY=work claude-or qwen/qwen3-coder        any model id with a saved key
  claude-or moonshotai/kimi-k3                  try a model once without an alias
  OR_CONTEXT=262144 claude-or qwen/qwen3-coder  same, with its real context window
  claude-or --add ccluna openai/gpt-6-luna      add alias ccluna
  claude-or --update ccluna small openai/gpt-5-nano
                                                cheaper background model for ccluna
  claude-or --remove ccluna                     remove it again

Config: $cfgdir/
  aliases.json  alias definitions (edit by hand, then run claude-or --link)
  keys.json     saved OpenRouter keys and the active one (managed with --key-*)
Key lookup: --key-run / OR_KEY key, \$OPENROUTER_API_KEY, active key in keys.json, Keychain "openrouter-api-key"
Overrides: OR_CONTEXT (context window), OR_SMALL_MODEL (background model),
           OR_KEY (saved key by index or name, like --key-run)
EOF
  if ! whence -p jq >/dev/null; then
    print "\nAliases need jq (not installed); claude-or <vendor/model-id> works without it."
  elif [[ -r "$aliasfile" ]] && jq -e '.aliases | length > 0' "$aliasfile" >/dev/null 2>&1; then
    print "\nAliases:"
    list_aliases | sed 's/^/  /'
  else
    print "\nNo aliases yet: claude-or --add <alias> <model-id>"
  fi
}

case "$name" in
  claude-or)
    case "$1" in
      --list)   list_aliases; exit ;;
      --link)   link_aliases; exit ;;
      --unlink) unlink_aliases; exit ;;
      --add)    shift; add_alias "$@"; exit ;;
      --update) shift; update_alias "$@"; exit ;;
      --remove) shift; remove_alias "$@"; exit ;;
      --key-add)    shift; key_add "$@"; exit ;;
      --key-remove) shift; key_remove "$@"; exit ;;
      --key-list)   shift; key_list "$@"; exit ;;
      --key-switch) shift; key_switch "$@"; exit ;;
      --stats)      shift; key_stats "$@"; exit ;;
      --key-run)
        # Not an exit: picks the key for this run, then the alias/model below runs as usual.
        (( $# >= 3 )) || die "usage: claude-or --key-run <index|name> <alias|model-id> [claude args...]"
        need_keys; resolve_key "$2"; runkey="$kname"; shift 2 ;;
      --set-key|--unset-key)
        die "$1 was replaced by the key manager: --key-add, --key-remove, --key-list, --key-switch" ;;
      --self-update)        self_update; exit ;;
      --self-factory-reset) shift; self_factory_reset "$@"; exit ;;
      --self-uninstall)     shift; self_uninstall "$@"; exit ;;
      ""|-h|--help) show_help; exit ;;
      -*)       die "unknown option '$1' (see claude-or --help)" ;;
    esac
    if [[ "$1" != */* ]]; then
      # No slash: not an OpenRouter model id (those are vendor/model), so it must be an alias.
      need_aliases
      load_alias "$1" || die "'$1' is neither an alias (see claude-or --list) nor a vendor/model id"
    else
      model="$1"
      [[ -r "$aliasfile" ]] && whence -p jq >/dev/null \
        && small="$(jq -r '.defaults.small // empty' "$aliasfile" 2>/dev/null)"
    fi
    shift ;;
  *)
    need_aliases
    load_alias "$name" || die "alias '$name' not found in $aliasfile"
    ;;
esac

ctx="${OR_CONTEXT:-$ctx}"
small="${OR_SMALL_MODEL:-${small:-$model}}"
# OR_KEY does what --key-run does, and also works with alias symlinks; --key-run wins.
if [[ -z "$runkey" && -n "$OR_KEY" ]]; then
  need_keys; resolve_key "$OR_KEY"; runkey="$kname"
fi

if [[ -n "$runkey" ]]; then
  # A key named with --key-run wins over every other source, $OPENROUTER_API_KEY included.
  key="$(jq -r --arg n "$runkey" '.keys[] | select(.name == $n) | .key' "$keysfile")"
else
  key="$OPENROUTER_API_KEY"
  [[ -z "$key" && -r "$keysfile" ]] && whence -p jq >/dev/null \
    && key="$(jq -r '.active as $a | .keys[]? | select(.name == $a) | .key' "$keysfile" 2>/dev/null)"
  [[ -z "$key" ]] && key="$(security find-generic-password -a "$USER" -s openrouter-api-key -w 2>/dev/null)"
fi
[[ -n "$key" ]] || die "no OpenRouter key: claude-or --key-add <name> (or --key-switch if keys are saved;
or \$OPENROUTER_API_KEY, or Keychain 'openrouter-api-key')"

# Every model tier in /model (Fable, Opus, Sonnet, Haiku) points at OpenRouter models: a tier left
# unset keeps its Claude default and OpenRouter would bill it at Anthropic prices.
desc="OpenRouter via claude-or"

# CLAUDECODE is unset so this also runs when launched from inside a Claude Code session.
# CLAUDE_CODE_MAX_CONTEXT_TOKENS: Claude Code doesn't know these models and would assume 200k.
exec env -u CLAUDECODE \
  ANTHROPIC_BASE_URL="https://openrouter.ai/api" \
  ANTHROPIC_AUTH_TOKEN="$key" \
  ANTHROPIC_API_KEY="" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_DEFAULT_FABLE_MODEL="$model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$model" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$small" \
  ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION="$desc" \
  ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION="$desc" \
  ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION="$desc" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION="$desc, background model" \
  ANTHROPIC_SMALL_FAST_MODEL="$small" \
  CLAUDE_CODE_SUBAGENT_MODEL="$model" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  ${ctx:+CLAUDE_CODE_MAX_CONTEXT_TOKENS=$ctx} \
  claude "$@"
